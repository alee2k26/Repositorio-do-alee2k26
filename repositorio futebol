    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        navy: {
                            950: '#030712',
                            900: '#0b1329',
                            800: '#0f172a',
                            700: '#1e293b',
                            600: '#334155',
                        },
                        azure: {
                            500: '#3b82f6',
                            400: '#60a5fa',
                            300: '#93c5fd',
                            glow: '#2563eb'
                        }
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    },
                    animation: {
                        'heart-bounce': 'heartPop 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275)',
                        'glow-pulse': 'glowPulse 2s infinite alternate',
                    },
                    keyframes: {
                        heartPop: {
                            '0%': { transform: 'scale(1)' },
                            '50%': { transform: 'scale(1.35)' },
                            '100%': { transform: 'scale(1)' },
                        },
                        glowPulse: {
                            '0%': { boxShadow: '0 0 15px rgba(59, 130, 246, 0.3)' },
                            '100%': { boxShadow: '0 0 25px rgba(96, 165, 250, 0.6)' },
                        }
                    }
                }
            }
        }
