<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Football Page</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #2512d1b2;
            text-align: center;
        }
        .container {
            max-width: 600px;
            margin: 0 auto;
            padding: 20px;
            background: rgb(22, 140, 250);
            border-radius: 8px;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
        }
        .like-dislike {
            margin: 20px 0;
        }
        button {
            padding: 10px 20px;
            margin: 5px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
        }
        .like {
            background-color: #15aed4;
            color: rgb(80, 18, 197);
        }
        .dislike {
            background-color: #000000;
            color: rgb(153, 147, 147);
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>Welcome to the Football Page!</h1>
        <p>Share your love for football!</p>
        <div class="like-dislike">
            <button class="like" onclick="like()">Like</button>
            <button class="dislike" onclick="dislike()">Dislike</button>
        </div>
        <p id="likes">Likes: 0</p>
        <p id="dislikes">Dislikes: 0</p>
    </div>

    <script>
        let likeCount = 0;
        let dislikeCount = 0;

        function like() {
            likeCount++;
            document.getElementById('likes').innerText = 'Likes: ' + likeCount;
        }

        function dislike() {
            dislikeCount++;
            document.getElementById('dislikes').innerText = 'Dislikes: ' + dislikeCount;
        }
    </script>
</body>
</html>